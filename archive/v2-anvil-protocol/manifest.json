{
  "manifest_version": 3,
  "name": "Anvil Protocol",
  "version": "2.0",
  "description": "Biometric Writing Environment & Verification",
  "permissions": ["storage", "clipboardWrite"],
  "action": {
    "default_title": "Open Anvil Writer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
