{
  "manifest_version": 3,
  "name": "JITTEr - Prove Your Writing is Human",
  "version": "3.0.0",
  "description": "Sign your articles with cryptographic proof of human authorship. Works on Medium, Substack, Google Docs, and everywhere you write.",

  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "JITTEr - Sign Your Work"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/biometrics.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
