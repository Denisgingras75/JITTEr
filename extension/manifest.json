{
  "manifest_version": 3,
  "name": "Jitter Protocol",
  "version": "3.0",
  "description": "Records how you type on sites you enable, never what you type, and signs a process receipt.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "https://fmguuhnustgcqzgjaoil.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jitter Protocol"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
